{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ComistryMo/llm_interview_lab/workspace/schema/profile.schema.json",
  "title": "LLM Interview Lab learner profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "synthetic",
    "target_roles",
    "experience_level",
    "weekly_hours",
    "preferences"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "synthetic": {
      "type": "boolean"
    },
    "target_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "experience_level": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": ["beginner", "intermediate", "advanced"]
      }
    },
    "weekly_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 80
    },
    "career_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_job_titles",
        "employment_stage",
        "preferred_locations",
        "interview_languages",
        "priorities"
      ],
      "properties": {
        "target_job_titles": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "employment_stage": {
          "enum": ["internship", "new_grad", "experienced", "flexible"]
        },
        "preferred_locations": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "interview_languages": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
          }
        },
        "priorities": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "role_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_role", "seniority", "skill_self_assessment", "ai_mode"],
      "properties": {
        "primary_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "seniority": {
          "enum": ["intern", "new_grad", "mid", "senior"]
        },
        "skill_self_assessment": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {"pattern": "^skill\\."},
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "ai_mode": {
          "enum": ["disabled", "provider", "codex"]
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pressure",
        "implementation_first",
        "require_retention"
      ],
      "properties": {
        "pressure": {
          "enum": ["low", "medium", "high"]
        },
        "implementation_first": {
          "type": "boolean"
        },
        "require_retention": {
          "type": "boolean"
        },
        "allow_experimental_problems": {
          "type": "boolean"
        }
      }
    }
  }
}
