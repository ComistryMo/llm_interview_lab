{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ComistryMo/llm_interview_lab/workspace/schema/profile.schema.json",
  "title": "LLM Interview Lab learner profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "synthetic",
    "target_roles",
    "experience_level",
    "weekly_hours",
    "preferences"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "target_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "experience_level": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": ["beginner", "intermediate", "advanced"]
      }
    },
    "weekly_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 80
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pressure",
        "implementation_first",
        "require_retention"
      ],
      "properties": {
        "pressure": {
          "enum": ["low", "medium", "high"]
        },
        "implementation_first": {
          "type": "boolean"
        },
        "require_retention": {
          "type": "boolean"
        }
      }
    }
  }
}
