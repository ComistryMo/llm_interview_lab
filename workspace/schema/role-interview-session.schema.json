{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ComistryMo/llm_interview_lab/workspace/schema/role-interview-session.schema.json",
  "title": "Profile-local role interview session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "interview_id", "profile_id", "status", "created_at",
    "role_id", "seniority", "difficulty", "blueprint_id", "duration_minutes",
    "ai_mode", "material_refs", "questions", "plan_fingerprint", "started_at",
    "deadline", "answers", "coding_evidence", "assessments", "followups",
    "timeline", "result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "interview_id": {"type": "string", "pattern": "^role-interview-[0-9]{4}$"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "status": {"enum": ["ready", "active", "paused", "completed", "incomplete"]},
    "created_at": {"type": "string", "format": "date-time"},
    "role_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "seniority": {"enum": ["intern", "new_grad", "mid"]},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "blueprint_id": {"type": "string", "pattern": "^interview\\."},
    "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 150},
    "ai_mode": {"enum": ["disabled", "provider", "codex"]},
    "plan_mode": {"enum": ["ai_generated"]},
    "plan_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "delivery_mode": {"enum": ["full_blueprint", "non_coding_fallback"]},
    "blueprint_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_blueprint", "coverage_weight", "included_round_indices", "omitted_rounds"],
      "properties": {
        "full_blueprint": {"const": false},
        "coverage_weight": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "included_round_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "omitted_rounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["round_index", "type", "reason", "environment", "duration_minutes", "weight"],
            "properties": {
              "round_index": {"type": "integer", "minimum": 0},
              "type": {"const": "coding"},
              "reason": {"enum": ["missing_environment", "no_validated_local_coding"]},
              "environment": {"enum": ["pytorch", "catalog"]},
              "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
              "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "material_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "kind", "title", "allowed_use"],
        "properties": {
          "id": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "kind": {"type": "string"},
          "title": {"type": "string"},
          "allowed_use": {"const": "role_interview"}
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/question"}
    },
    "plan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "deadline": {"type": ["string", "null"], "format": "date-time"},
    "paused_at": {"type": ["string", "null"], "format": "date-time"},
    "paused_remaining_seconds": {"type": ["integer", "null"], "minimum": 1},
    "answers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/answer"}
    },
    "coding_evidence": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/coding_evidence"}
    },
    "assessments": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/assessment"}
    },
    "followups": {
      "type": "array",
      "items": {"$ref": "#/$defs/followup"}
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event", "timestamp"],
        "properties": {
          "event": {"enum": ["created", "started", "paused", "resumed", "answered", "coding_tested", "finished"]},
          "timestamp": {"type": "string", "format": "date-time"},
          "question_id": {"type": "string", "pattern": "^q-[0-9]{3}$"}
        },
        "additionalProperties": false
      }
    },
    "result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/result"}]}
  },
  "allOf": [
    {
      "if": {
        "required": ["plan_mode"],
        "properties": {"plan_mode": {"const": "ai_generated"}}
      },
      "then": {"required": ["plan_context_sha256"]},
      "else": {"not": {"required": ["plan_context_sha256"]}}
    },
    {
      "if": {
        "required": ["delivery_mode"],
        "properties": {"delivery_mode": {"const": "non_coding_fallback"}}
      },
      "then": {
        "required": ["blueprint_coverage"],
        "properties": {"questions": {"minItems": 1}}
      },
      "else": {
        "properties": {
          "duration_minutes": {"minimum": 30},
          "questions": {"minItems": 2}
        },
        "not": {"required": ["blueprint_coverage"]}
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sha256"],
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "ai_generated"}}},
          "then": {"required": ["context_sha256", "rubric_sha256"]}
        }
      ],
      "properties": {
        "kind": {"enum": ["fixed_item", "catalog_problem", "ai_generated"]},
        "id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "rubric_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "anchors"],
      "properties": {
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["1", "3", "5"],
          "properties": {"1": {"type": "string"}, "3": {"type": "string"}, "5": {"type": "string"}}
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "fatal_issues"],
      "properties": {
        "dimensions": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/rubric_dimension"}},
        "fatal_issues": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "round_index", "kind", "title", "timebox_minutes", "round_weight", "skills", "source", "prompt", "rubric"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^q-[0-9]{3}$"},
        "round_index": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["coding", "debugging", "product_case", "system_design", "evaluation_case", "project_deep_dive", "behavioral", "oral"]},
        "title": {"type": "string", "minLength": 1},
        "timebox_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
        "round_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "skills": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^skill\\."}},
        "source": {"$ref": "#/$defs/source"},
        "prompt": {"type": "string", "minLength": 1},
        "rubric": {"$ref": "#/$defs/rubric"}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "recorded_at"],
      "properties": {
        "relative_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "coding_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submission_sha256", "status", "passed", "failed", "duration_ms", "recorded_at"],
      "properties": {
        "submission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["passed", "failed", "timed_out", "collection_error", "import_error", "internal_error"]},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scores", "evidence", "source", "confidence", "fatal_issues", "recorded_at"],
      "properties": {
        "scores": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 5}},
        "evidence": {"type": "string", "minLength": 1},
        "source": {"enum": ["human", "ai", "self", "grader"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "fatal_issues": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "followup_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^f-[0-9]{3}$"}},
        "answer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["followup_id", "parent_question_id", "prompt", "answer", "source", "recorded_at"],
      "properties": {
        "followup_id": {"type": "string", "pattern": "^f-[0-9]{3}$"},
        "parent_question_id": {"type": "string", "pattern": "^q-[0-9]{3}$"},
        "prompt": {"type": "string", "minLength": 1},
        "answer": {"type": "string", "minLength": 1},
        "source": {"enum": ["human", "ai"]},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completion_status", "overall_score", "question_scores", "skill_scores", "unanswered", "unscored", "critical_gaps", "summary", "finished_at", "expired"],
      "properties": {
        "completion_status": {"enum": ["completed", "incomplete"]},
        "overall_score": {"type": "number", "minimum": 0, "maximum": 100},
        "question_scores": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}},
        "skill_scores": {"type": "object", "additionalProperties": {"type": "object"}},
        "unanswered": {"type": "array", "items": {"type": "string"}},
        "unscored": {"type": "array", "items": {"type": "string"}},
        "critical_gaps": {"type": "array", "items": {"type": "string"}},
        "summary": {"type": "string"},
        "finished_at": {"type": "string", "format": "date-time"},
        "expired": {"type": "boolean"}
      }
    }
  }
}
